# Ollama Cloud API Keys (round-robin — add up to 6)
# Session resets every 4 hours, weekly reset of 4 days
OLLAMA_API_KEY_1=your_ollama_api_key_here
# OLLAMA_API_KEY_2=your_second_key_here
# OLLAMA_API_KEY_3=your_third_key_here

# Ollama Cloud Configuration
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_MODEL=gpt-oss-120b

# Frontend API URL
# - For local dev: leave empty (Vite proxy handles it)
# - For production: https://your-backend-api.com
VITE_API_URL=

# MongoDB Connection - use a cloud MongoDB (MongoDB Atlas recommended)
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb://localhost:27017/interprepai

# JWT Configuration — CHANGE THESE IN PRODUCTION
JWT_SECRET=change-this-to-a-random-64-char-hex-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-to-a-different-random-64-char-hex-string
JWT_REFRESH_EXPIRES_IN=30d

# Server Configuration
PORT=5000
NODE_ENV=development

# Backend CORS configuration - comma-separated allowed origins
CORS_ORIGIN=http://localhost:3000
